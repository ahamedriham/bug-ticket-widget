{
  "name": "bug-ticket-widget",
  "version": "1.1.0",
  "description": "Floating bug-report & support widget: screenshots, area/element capture, markup editor, screen recording, console/network diagnostics. Framework-agnostic, Shadow-DOM isolated.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahamedriham/bug-ticket-widget.git"
  },
  "homepage": "https://github.com/ahamedriham/bug-ticket-widget#readme",
  "bugs": {
    "url": "https://github.com/ahamedriham/bug-ticket-widget/issues"
  },
  "type": "module",
  "main": "./dist/bug-ticket.cjs",
  "module": "./dist/bug-ticket.esm.js",
  "browser": "./dist/bug-ticket.umd.js",
  "unpkg": "./dist/bug-ticket.umd.js",
  "jsdelivr": "./dist/bug-ticket.umd.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/bug-ticket.esm.js",
      "require": "./dist/bug-ticket.cjs",
      "default": "./dist/bug-ticket.esm.js"
    },
    "./umd": "./dist/bug-ticket.umd.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md"
  ],
  "sideEffects": [
    "./dist/bug-ticket.umd.js",
    "./src/umd.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "html2canvas": "^1.4.1"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "html2canvas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-dom": "^3.5.0",
    "esbuild": "^0.24.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "bug report",
    "feedback widget",
    "screenshot",
    "html2canvas",
    "screen recording",
    "support widget",
    "vue",
    "laravel",
    "shadow dom"
  ]
}
